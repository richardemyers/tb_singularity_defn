BootStrap: debootstrap
OSVersion: jammy
MirrorURL: http://us.archive.ubuntu.com/ubuntu/

%setup
    SINDEF_CONTENT_DIR="${SINDEF_CONTENT_DIR:-$HOME}"

    cp -p ${SINDEF_CONTENT_DIR}/parse_mykrobe_species/*.py ${SINGULARITY_ROOTFS}/opt/

    cp -p ${SINDEF_CONTENT_DIR}/singularity_defs/tb_mykrobe.sindef ${SINGULARITY_ROOTFS}/.singularity-definition
    
    GIT_VERSION=$(git -C "${SINDEF_CONTENT_DIR}/singularity_defs" log -1 --pretty=format:"%H")
    if [ ! -z "$(git -C "${SINDEF_CONTENT_DIR}/singularity_defs" status --untracked-files=no --porcelain)" ]; then GIT_VERSION="$GIT_VERSION"-unclean; fi
    echo $GIT_VERSION > ${SINGULARITY_ROOTFS}/.git-version
 
%labels
    Version 0.4
 
%post
    echo "Hello from inside the container"
    sed -i 's/$/ universe/' /etc/apt/sources.list
    apt-get update
    apt-get -y install git wget jq
    apt-get clean

    cd /opt
    wget https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh
    bash Miniforge3-Linux-x86_64.sh -b -p /opt/miniforge
    export PATH="/opt/miniforge/bin:$PATH"
 
    conda create -n mykro
    . /opt/miniforge/etc/profile.d/conda.sh
    conda install -c bioconda mykrobe=0.13.0
 
%environment
    export LC_ALL=C
    export PATH=/opt/miniforge/bin:$PATH
